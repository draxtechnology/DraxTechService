<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Version convention: tracks the service's AssemblyFileVersion with the
       third field dropped - file 1.0.0.N installs as MSI 1.0.N, so Programs
       and Features and the service log banner read as the same release.
       Bump BOTH together (AssemblyInfo.cs + here); MSI won't upgrade over
       an equal version. -->
  <Package Name="Drax Technology Service"
           Manufacturer="Drax Technology"
           Version="1.0.33"
           UpgradeCode="B5758DCA-6BC5-4E2C-BF55-7FA118631F65"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="Drax Technology Network Manager"
                        Keywords="Installer,Drax,NetworkManager" />

    <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed." />

    <Media Id="1" Cabinet="files.cab" EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DraxService.ico" SourceFile="..\Drax360NetworkManager\DraxLogo.ico" />
    <Property Id="ARPPRODUCTICON" Value="DraxService.ico" />

    <!-- The service targets net10.0-windows. The .NET 10 Runtime is not
         gated here — pair this MSI with a bootstrapper bundle (mirroring
         DraxTechClient/DraxClientSetup) when shipping to a fresh machine. -->

    <!-- One product, four side-by-side service instances (AMX's own dongle
         caps a site at four network managers, ports 3090-3093 — see
         AMXTransfer.cs). Each instance's config is stamped with its
         AmxInstance and a blank (UNCONFIGURED) panel type; the service
         derives port/pipes/name from that one number and its base folder
         from the install location (drive-agnostic), seeds its ini files from
         the install's ini\ templates on first run, and refuses to start
         until AMX writes the licence panel type or an engineer sets it. There is deliberately no upgrade path from the old
         single-instance product (service name "DraxTechnology", folder
         C:\AMX1) — the 2 sites on that scheme today get migrated by hand,
         not by MSI upgrade logic. -->
    <Feature Id="Core" Title="Core" Level="1" AllowAbsent="no" Display="hidden">
      <ComponentGroupRef Id="SharedEventSource" />
      <ComponentGroupRef Id="IniFiles" />
    </Feature>
    <!-- All four instances install unconditionally and sit dormant (Manual
         start) until a site needs them — Mike/James's explicit direction
         (2026-08-11): no instance question at install time; a licence change
         just starts a different service, never the installer again. The
         per-instance feature split is kept purely as structure (msiexec
         REMOVE=InstanceN stays possible for edge cases). -->
    <Feature Id="Instance1" Title="Service Instance 1 (C:\AMX1\NWM1, port 3090)"
             Description="Drax Technology Service 1 — installs to C:\AMX1\NWM1, AMX port 3090."
             Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="ServiceComponents1" />
      <ComponentGroupRef Id="DependencyFiles1" />
      <ComponentGroupRef Id="WinRuntimeFiles1" />
      <ComponentGroupRef Id="FolderPermissions1" />
    </Feature>
    <Feature Id="Instance2" Title="Service Instance 2 (C:\AMX1\NWM2, port 3091)"
             Description="Drax Technology Service 2 — installs to C:\AMX1\NWM2, AMX port 3091."
             Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="ServiceComponents2" />
      <ComponentGroupRef Id="DependencyFiles2" />
      <ComponentGroupRef Id="WinRuntimeFiles2" />
      <ComponentGroupRef Id="FolderPermissions2" />
    </Feature>
    <Feature Id="Instance3" Title="Service Instance 3 (C:\AMX1\NWM3, port 3092)"
             Description="Drax Technology Service 3 — installs to C:\AMX1\NWM3, AMX port 3092."
             Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="ServiceComponents3" />
      <ComponentGroupRef Id="DependencyFiles3" />
      <ComponentGroupRef Id="WinRuntimeFiles3" />
      <ComponentGroupRef Id="FolderPermissions3" />
    </Feature>
    <Feature Id="Instance4" Title="Service Instance 4 (C:\AMX1\NWM4, port 3093)"
             Description="Drax Technology Service 4 — installs to C:\AMX1\NWM4, AMX port 3093."
             Level="1" AllowAdvertise="no">
      <ComponentGroupRef Id="ServiceComponents4" />
      <ComponentGroupRef Id="DependencyFiles4" />
      <ComponentGroupRef Id="WinRuntimeFiles4" />
      <ComponentGroupRef Id="FolderPermissions4" />
    </Feature>

    <!-- Minimal UI: single Install button → progress → Finish.
         No instance question (Mike/James, 2026-08-11) and no directory or
         license pages — all four instances install to their fixed
         C:\AMX1..4 paths and sit dormant until configured and started. -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Logo bitmaps — regenerate with DraxServiceSetup\MakeBitmaps.ps1
         if DraxLogo.png is updated. -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />

    <!-- C:\AMX1\NWM1..4\ as install locations, each with its own
         runtimes\win\lib\net10.0\ subtree that the .NET runtime expects for
         RID-specific NuGet assets (ServiceController, EventLog, etc.) — every
         instance is a complete, independent copy of the app, since each needs
         its own DraxTechnology.dll.config next to its own exe (the ini
         templates are the one exception — shared, see below). The leaf folder
         name must match the TFM in Drax360Service.csproj — the runtime resolves
         it literally from runtimeTargets in deps.json. -->
    <!-- James's layout (2026-08-11): everything lives under the one C:\AMX1
         tree — instances 1-4 as NWM1..NWM4 subfolders, so AMX's own files
         and every network manager share one root. The old scheme was
         separate C:\AMX2..4 folders. The ini templates are identical across
         instances (Files.wxs sources all four from the same build output),
         so they ship once to a single shared C:\AMX1\ini rather than being
         duplicated into every NWM{n}\ini — SeedIniTemplates in
         DraxService.cs reads from there (one level up from its own instance
         folder) when it seeds each instance's live config on first run. -->
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="AmxRootDir" Name="AMX1">
        <Directory Id="IniFolder" Name="ini" />
        <Directory Id="INSTALLFOLDER1" Name="NWM1">
          <Directory Id="RuntimesDir1" Name="runtimes">
            <Directory Id="RuntimesWinDir1" Name="win">
              <Directory Id="RuntimesWinLibDir1" Name="lib">
                <Directory Id="WinRuntimeDir1" Name="net10.0" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
        <Directory Id="INSTALLFOLDER2" Name="NWM2">
          <Directory Id="RuntimesDir2" Name="runtimes">
            <Directory Id="RuntimesWinDir2" Name="win">
              <Directory Id="RuntimesWinLibDir2" Name="lib">
                <Directory Id="WinRuntimeDir2" Name="net10.0" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
        <Directory Id="INSTALLFOLDER3" Name="NWM3">
          <Directory Id="RuntimesDir3" Name="runtimes">
            <Directory Id="RuntimesWinDir3" Name="win">
              <Directory Id="RuntimesWinLibDir3" Name="lib">
                <Directory Id="WinRuntimeDir3" Name="net10.0" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
        <Directory Id="INSTALLFOLDER4" Name="NWM4">
          <Directory Id="RuntimesDir4" Name="runtimes">
            <Directory Id="RuntimesWinDir4" Name="win">
              <Directory Id="RuntimesWinLibDir4" Name="lib">
                <Directory Id="WinRuntimeDir4" Name="net10.0" />
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Grant the service account full control of each install folder so
         DraxService can write log files, NWM temp files, and Current.Nwm. -->
    <ComponentGroup Id="FolderPermissions1" Directory="INSTALLFOLDER1">
      <Component Id="AmxFolderPermission1" Guid="B2C6D3E4-5F6A-7B8C-9D0E-1F2A3B4C5D6E">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="FolderPermissions2" Directory="INSTALLFOLDER2">
      <Component Id="AmxFolderPermission2" Guid="C3D7E4F5-6A7B-8C9D-0E1F-2A3B4C5D6E7F">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="FolderPermissions3" Directory="INSTALLFOLDER3">
      <Component Id="AmxFolderPermission3" Guid="D4E8F5A6-7B8C-9D0E-1F2A-3B4C5D6E7F80">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="FolderPermissions4" Directory="INSTALLFOLDER4">
      <Component Id="AmxFolderPermission4" Guid="E5F9A6B7-8C9D-0E1F-2A3B-4C5D6E7F8091">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- Registered once, shared by all four instances' Application-log sources
         (see the per-instance util:EventSource below) — the Service-log source
         Drax360NetworkManager's own EventLogger.cs writes under is not instance-
         scoped, so registering it four times would just recreate the same
         registry key redundantly. -->
    <ComponentGroup Id="SharedEventSource" Directory="INSTALLFOLDER1">
      <Component Id="Drax360ServiceLogEventSource" Guid="F6A0B7C8-9D0E-1F2A-3B4C-5D6E7F809102">
        <util:EventSource Name="Drax360"
                          Log="Service"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
      </Component>
    </ComponentGroup>

    <!-- Service components: one per instance, each holding its own EXE + service
         install/control. Internal service Name is "DraxTechnology{n}" (must match
         DraxService.Designer.cs's this.ServiceName exactly — SCM dispatches to a
         running process by this string) with a human-readable DisplayName of
         "Drax Technology Service {n}" — that's what shows in services.msc. -->
    <ComponentGroup Id="ServiceComponents1" Directory="INSTALLFOLDER1">
      <Component Id="DraxTechnologyExe1" Guid="A1B5C2D3-4E5F-6A7B-8C9D-0E1F2A3B4C5D">
        <File Id="DraxTechnology1.exe"
              Source="$(var.Drax360Service.TargetDir)DraxTechnology.exe"
              KeyPath="yes" />
        <!-- Stamp this install's own folder + instance number into its config so
             every path (inis, logs, temp, analogue database) and the AMX port /
             pipe suffix (AMXTransfer.ReadConfiguredInstanceNumber) resolve to
             instance 1 specifically. -->
        <util:XmlFile Id="StampConfigurationBase1"
                      File="[INSTALLFOLDER1]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Configuration'[\]]"
                      Name="value"
                      Value="[INSTALLFOLDER1]" />
        <util:XmlFile Id="StampAmxInstance1"
                      File="[INSTALLFOLDER1]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='AmxInstance'[\]]"
                      Name="value"
                      Value="1" />
        <!-- Blank the panel type: a freshly installed instance is dormant and
             must not half-run as the dev default panel. UNCONFIGURED fails
             the service's valid-panel check, so the SCM start refuses with a
             clear event-log reason until AMX writes the licence panel type
             into this config or an engineer sets it. -->
        <util:XmlFile Id="StampPanelsBlank1"
                      File="[INSTALLFOLDER1]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Panels'[\]]"
                      Name="value"
                      Value="UNCONFIGURED" />
        <util:EventSource Name="DraxTechnology1"
                          Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
        <ServiceInstall Id="DraxTechnologyService1"
                        Name="DraxTechnology1"
                        DisplayName="Drax Technology Service 1"
                        Description="Drax Technology Network Manager (instance 1)"
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <util:PermissionEx User="Users"
                             ServiceQueryStatus="yes"
                             ServiceStart="yes"
                             ServiceStop="yes"
                             ServiceInterrogate="yes" />
        </ServiceInstall>
        <ServiceControl Id="DraxTechnologyServiceControl1"
                        Name="DraxTechnology1"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ServiceComponents2" Directory="INSTALLFOLDER2">
      <Component Id="DraxTechnologyExe2" Guid="1A2B3C4D-5E6F-7081-92A3-B4C5D6E7F809">
        <File Id="DraxTechnology2.exe"
              Source="$(var.Drax360Service.TargetDir)DraxTechnology.exe"
              KeyPath="yes" />
        <util:XmlFile Id="StampConfigurationBase2"
                      File="[INSTALLFOLDER2]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Configuration'[\]]"
                      Name="value"
                      Value="[INSTALLFOLDER2]" />
        <util:XmlFile Id="StampAmxInstance2"
                      File="[INSTALLFOLDER2]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='AmxInstance'[\]]"
                      Name="value"
                      Value="2" />
        <util:XmlFile Id="StampPanelsBlank2"
                      File="[INSTALLFOLDER2]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Panels'[\]]"
                      Name="value"
                      Value="UNCONFIGURED" />
        <util:EventSource Name="DraxTechnology2"
                          Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
        <ServiceInstall Id="DraxTechnologyService2"
                        Name="DraxTechnology2"
                        DisplayName="Drax Technology Service 2"
                        Description="Drax Technology Network Manager (instance 2)"
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <util:PermissionEx User="Users"
                             ServiceQueryStatus="yes"
                             ServiceStart="yes"
                             ServiceStop="yes"
                             ServiceInterrogate="yes" />
        </ServiceInstall>
        <ServiceControl Id="DraxTechnologyServiceControl2"
                        Name="DraxTechnology2"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ServiceComponents3" Directory="INSTALLFOLDER3">
      <Component Id="DraxTechnologyExe3" Guid="2B3C4D5E-6F70-8192-A3B4-C5D6E7F80910">
        <File Id="DraxTechnology3.exe"
              Source="$(var.Drax360Service.TargetDir)DraxTechnology.exe"
              KeyPath="yes" />
        <util:XmlFile Id="StampConfigurationBase3"
                      File="[INSTALLFOLDER3]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Configuration'[\]]"
                      Name="value"
                      Value="[INSTALLFOLDER3]" />
        <util:XmlFile Id="StampAmxInstance3"
                      File="[INSTALLFOLDER3]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='AmxInstance'[\]]"
                      Name="value"
                      Value="3" />
        <util:XmlFile Id="StampPanelsBlank3"
                      File="[INSTALLFOLDER3]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Panels'[\]]"
                      Name="value"
                      Value="UNCONFIGURED" />
        <util:EventSource Name="DraxTechnology3"
                          Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
        <ServiceInstall Id="DraxTechnologyService3"
                        Name="DraxTechnology3"
                        DisplayName="Drax Technology Service 3"
                        Description="Drax Technology Network Manager (instance 3)"
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <util:PermissionEx User="Users"
                             ServiceQueryStatus="yes"
                             ServiceStart="yes"
                             ServiceStop="yes"
                             ServiceInterrogate="yes" />
        </ServiceInstall>
        <ServiceControl Id="DraxTechnologyServiceControl3"
                        Name="DraxTechnology3"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ServiceComponents4" Directory="INSTALLFOLDER4">
      <Component Id="DraxTechnologyExe4" Guid="3C4D5E6F-7081-92A3-B4C5-D6E7F8091021">
        <File Id="DraxTechnology4.exe"
              Source="$(var.Drax360Service.TargetDir)DraxTechnology.exe"
              KeyPath="yes" />
        <util:XmlFile Id="StampConfigurationBase4"
                      File="[INSTALLFOLDER4]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Configuration'[\]]"
                      Name="value"
                      Value="[INSTALLFOLDER4]" />
        <util:XmlFile Id="StampAmxInstance4"
                      File="[INSTALLFOLDER4]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='AmxInstance'[\]]"
                      Name="value"
                      Value="4" />
        <util:XmlFile Id="StampPanelsBlank4"
                      File="[INSTALLFOLDER4]DraxTechnology.dll.config"
                      Action="setValue"
                      ElementPath="//configuration/appSettings/add[\[]@key='Panels'[\]]"
                      Name="value"
                      Value="UNCONFIGURED" />
        <util:EventSource Name="DraxTechnology4"
                          Log="Application"
                          EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
        <ServiceInstall Id="DraxTechnologyService4"
                        Name="DraxTechnology4"
                        DisplayName="Drax Technology Service 4"
                        Description="Drax Technology Network Manager (instance 4)"
                        Type="ownProcess"
                        Start="demand"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <util:PermissionEx User="Users"
                             ServiceQueryStatus="yes"
                             ServiceStart="yes"
                             ServiceStop="yes"
                             ServiceInterrogate="yes" />
        </ServiceInstall>
        <ServiceControl Id="DraxTechnologyServiceControl4"
                        Name="DraxTechnology4"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

  </Package>

</Wix>
